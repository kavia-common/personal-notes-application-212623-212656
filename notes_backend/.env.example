# Required environment variables for Notes Backend

# MongoDB connection
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=notes_app

# JWT configuration
JWT_SECRET=please_change_me_to_a_strong_random_secret
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS origins (comma-separated). Defaults to http://localhost:3000 if unset.
# Example: http://localhost:3000,https://preview-your-deployment.example.com
CORS_ORIGINS=http://localhost:3000
