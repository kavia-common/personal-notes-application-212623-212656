# Example backend environment configuration

# MongoDB connection
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=notes_app

# JWT configuration
JWT_SECRET=REPLACE_WITH_A_SECURE_RANDOM_SECRET
# Optional JWT algorithm (defaults to HS256)
# JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS origins (comma-separated). Include frontend URL(s).
# Local dev:
CORS_ORIGINS=http://localhost:3000
# For preview/cloud add additional origins separated by commas, e.g.:
# CORS_ORIGINS=http://localhost:3000,https://your-preview-host.example.com
